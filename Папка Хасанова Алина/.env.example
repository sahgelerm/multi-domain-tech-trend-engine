# .env.example - скопировать в .env на сервере
# Переменные окружения для дашборда Tech Trends Monitor

# ============================================
# Режим работы
# ============================================
# bigquery - подключение к BigQuery (production)
# parquet - локальные файлы (для тестирования)
DASHBOARD_MODE=bigquery

# ============================================
# BigQuery настройки
# ============================================
# ID проекта в Google Cloud
GCP_PROJECT=project-7a7c09b1-b387-4931-856

# Название датасета (уточнить у Натальи!)
# Варианты: indlab_data, tech_trends, openalex
GCP_DATASET=indlab_data

# Путь к service account ключу на сервере
GOOGLE_APPLICATION_CREDENTIALS=/home/ubuntu/.gcp/service-key.json

# ============================================
# Streamlit настройки (опционально)
# ============================================
# Порт для запуска
STREAMLIT_PORT=8501

# Хост (0.0.0.0 для внешнего доступа)
STREAMLIT_SERVER_ADDRESS=0.0.0.0

# ============================================
# Пути к данным (для режима parquet)
# ============================================
# DATA_PATH=/home/ubuntu/indlab-data
